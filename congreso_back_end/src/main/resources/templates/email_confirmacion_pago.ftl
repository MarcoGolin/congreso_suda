<!-- ======== PREHEADER (previa en bandeja) ======== -->
<span style="display:none !important; font-size:1px; color:#ffffff; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">
  ¡Tu inscripción al #IVCIUSMI2025 ha sido confirmada exitosamente!
</span>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7f8; margin:0; padding:0;">
  <tr>
    <td align="center" style="padding:24px;">
      <!-- Card -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:650px; background:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #e8ebee;">
        
        <!-- Logo -->
        <tr>
          <td align="center" style="padding:28px 28px 12px;">
            <img src="https://congresounisud.com/assets/imagenes/logo/logo_congreso.png"
                 alt="Logo del IV Congreso Internacional de la Universidad Sudamericana"
                 width="220" style="display:block; border:0; outline:none; text-decoration:none; width:220px; height:auto;">
          </td>
        </tr>

        <!-- Encabezados -->
        <tr>
          <td style="padding:0 28px 4px; font-family:'Segoe UI', Roboto, Arial, sans-serif;">
            <h2 style="margin:0; font-size:22px; line-height:1.35; color:#387f4d; font-weight:700;">
              ¡Tu inscripción al #IVCIUSMI2025 ha sido confirmada exitosamente! 🎉
            </h2>
          </td>
        </tr>

        <!-- Saludo -->
        <tr>
          <td style="padding:6px 28px 6px; font-family:'Segoe UI', Roboto, Arial, sans-serif; color:#333333; font-size:14px; line-height:1.6;">
            <p style="margin:0 0 12px;">Hola <strong>${nombre}</strong>,</p>
            <p style="margin:0 0 12px;">Nos complace informarte que tu pago ha sido procesado y registrado correctamente. A continuación, encontrarás los detalles de tu inscripción:</p>
          </td>
        </tr>

        <!-- Divider -->
        <tr>
          <td style="padding:0 28px;">
            <hr style="border:none; border-top:1px solid #e8ebee; margin:0;">
          </td>
        </tr>

        <!-- Datos de inscripción -->
        <tr>
          <td style="padding:14px 28px 0; font-family:'Segoe UI', Roboto, Arial, sans-serif;">
            <h4 style="margin:0 0 10px; font-size:15px; line-height:1.4; color:#387f4d; font-weight:700;">Datos de inscripción</h4>
          </td>
        </tr>
        <tr>
          <td style="padding:0 28px 8px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; font-family:'Segoe UI', Roboto, Arial, sans-serif; color:#333333; font-size:14px;">
              <tr><td style="padding:6px 0; width:42%;"><strong>Nombre</strong></td><td style="padding:6px 0;">${nombre}</td></tr>
              <tr><td style="padding:6px 0;"><strong>Monto</strong></td><td style="padding:6px 0;">${monto}</td></tr>
              <tr><td style="padding:6px 0;"><strong>Método de pago</strong></td><td style="padding:6px 0;">EFECTIVO</td></tr>
              <tr><td style="padding:6px 0;"><strong>Código comprobante</strong></td><td style="padding:6px 0;">${numeroComprobante}</td></tr>
              <tr><td style="padding:6px 0;"><strong>Fecha y hora</strong></td><td style="padding:6px 0;">${fechaPago}</td></tr>
              <tr><td style="padding:6px 0;"><strong>Código de inscripción</strong></td><td style="padding:6px 0;">${codigoInscripcion}</td></tr>
            </table>
          </td>
        </tr>

        <!-- Tu inscripción incluye -->
        <tr>
          <td style="padding:14px 28px 0; font-family:'Segoe UI', Roboto, Arial, sans-serif;">
            <h4 style="margin:0 0 10px; font-size:15px; line-height:1.4; color:#387f4d; font-weight:700;">Tu inscripción incluye</h4>
            <ul style="margin:0 0 16px 18px; padding:0; color:#333333; font-size:14px; line-height:1.6;">
              <li>Conferencias de alto nivel impartidas por expertos internacionales, nacionales y locales.</li>
              <li>Debates y actividades dinámicas.</li>
              <li>Oportunidades de networking académico y profesional.</li>
              <li>Participación en actividades simultáneas de las ligas académicas (con costo adicional).</li>
              <li>Envío de trabajos científicos para evaluación.</li>
              <li>Certificado de participación con acreditación en horas de investigación y extensión.</li>
              <li>Kit de bienvenida institucional.</li>
              <li>Acceso a coffee breaks durante los tres días del evento.</li>
            </ul>
          </td>
        </tr>

        <!-- Detalles del evento -->
        <tr>
          <td style="padding:16px 28px 0; font-family:'Segoe UI', Roboto, Arial, sans-serif;">
            <h4 style="margin:0 0 10px; font-size:15px; line-height:1.4; color:#387f4d; font-weight:700;">Detalles del evento</h4>
            <p style="margin:0 0 12px; color:#333333; font-size:14px; line-height:1.6;">
              📅 <strong>Fechas:</strong> 09, 10 y 11 de octubre de 2025<br>
              📍 <strong>Lugar:</strong> Shopping Mall Mercosur, Saltos del Guairá
            </p>
          </td>
        </tr>

        <!-- Acreditación -->
        <tr>
          <td style="padding:4px 28px 0; font-family:'Segoe UI', Roboto, Arial, sans-serif;">
            <h4 style="margin:16px 0 8px; font-size:15px; line-height:1.4; color:#387f4d; font-weight:700;">🎟️ Acreditación</h4>
            <p style="margin:0 0 12px; color:#333333; font-size:14px; line-height:1.6;">
              Para tu acreditación deberás presentar tu documento de identidad y/o este correo.<br>
              Al acreditarte recibirás tu kit de bienvenida y tu credencial con código QR.<br>
              La acreditación se realizará todos los días del evento, tanto al ingreso como a la salida, a fin de registrar tu participación.<br>
              Los horarios y puntos de acreditación serán informados oportunamente por correo electrónico y a través de nuestras redes oficiales.
            </p>
          </td>
        </tr>

        <!-- Contacto -->
        <tr>
          <td style="padding:0 28px 4px; font-family:'Segoe UI', Roboto, Arial, sans-serif; color:#333333; font-size:14px; line-height:1.6;">
            <p style="margin:0 0 18px;">
              📬 Consultas: <strong>consulta@congresounisud.com</strong><br>
              📱 WhatsApp: <strong>+595 983 043 756</strong>
            </p>
          </td>
        </tr>

        <!-- Despedida -->
        <tr>
          <td style="padding:0 28px; font-family:'Segoe UI', Roboto, Arial, sans-serif; color:#333333; font-size:14px; line-height:1.6;">
            <p style="margin:0 0 10px;">¡Gracias por ser parte de esta experiencia académica que transforma!</p>
            <p style="margin:0 0 2px;"><strong>Atentamente,</strong></p>
            <p style="margin:0 0 2px;"><strong>Comité Organizador – IV Congreso Internacional de la Universidad Sudamericana: Medicina Interdisciplinaria</strong></p>
          </td>
        </tr>

        <!-- Logo secundario -->
        <tr>
          <td align="center" style="padding:12px 28px 20px;">
            <img src="https://congresounisud.com/assets/imagenes/logo/unisud_investigacion_verde.png"
                 alt="Universidad Sudamericana – Investigación"
                 width="220" style="display:block; border:0; outline:none; text-decoration:none; width:220px; height:auto;">
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="padding:0 28px;">
            <hr style="border:none; border-top:1px solid #e8ebee; margin:0;">
          </td>
        </tr>
        <tr>
          <td style="padding:10px 20px 24px; text-align:center; font-family:'Segoe UI', Roboto, Arial, sans-serif;">
            <p style="margin:0 0 6px; font-size:12px; color:#6b7785;">
              Si no realizaste este pago, contactanos de inmediato.
            </p>
            <p style="margin:0; font-size:12px; color:#6b7785; font-style:italic;">
              Este mensaje fue enviado automáticamente. Por favor, no respondas a este correo.
            </p>
          </td>
        </tr>
      </table>
      <!-- /Card -->
    </td>
  </tr>
