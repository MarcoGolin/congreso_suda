2025-10-07T22:00:54.433-03:00 DEBUG 20440 --- [http-nio-8081-exec-6] p.c.f.m.c.C.resumenPorCobradorTurno      : ==>  Preparing: SELECT u.USUARIO_PAGO AS usuarioPagoId, u.USUARIO_PAGO AS usuarioPagoNombre, /* --- PAGOS por turno --- */ COALESCE(SUM(CASE WHEN u.BO_IS_PAGO = TRUE AND HOUR(u.FC_PAGO) BETWEEN 6 AND 12 THEN u.VL_PAGO ELSE 0 END), 0) AS montoDiaPagos, COALESCE(SUM(CASE WHEN u.BO_IS_PAGO = TRUE AND HOUR(u.FC_PAGO) BETWEEN 13 AND 18 THEN u.VL_PAGO ELSE 0 END), 0) AS montoTardePagos, COALESCE(SUM(CASE WHEN u.BO_IS_PAGO = TRUE AND (HOUR(u.FC_PAGO) >= 19 OR HOUR(u.FC_PAGO) <= 5) THEN u.VL_PAGO ELSE 0 END), 0) AS montoNochePagos, COALESCE(SUM(CASE WHEN u.BO_IS_PAGO = TRUE AND HOUR(u.FC_PAGO) BETWEEN 6 AND 12 THEN 1 ELSE 0 END), 0) AS cantDiaPagos, COALESCE(SUM(CASE WHEN u.BO_IS_PAGO = TRUE AND HOUR(u.FC_PAGO) BETWEEN 13 AND 18 THEN 1 ELSE 0 END), 0) AS cantTardePagos, COALESCE(SUM(CASE WHEN u.BO_IS_PAGO = TRUE AND (HOUR(u.FC_PAGO) >= 19 OR HOUR(u.FC_PAGO) <= 5) THEN 1 ELSE 0 END), 0) AS cantNochePagos, /* --- EXONERADOS por turno (sin monto) --- */ COALESCE(SUM(CASE WHEN u.BO_EXONERADO = TRUE AND HOUR(u.FC_PAGO) BETWEEN 6 AND 12 THEN 1 ELSE 0 END), 0) AS cantDiaEx, COALESCE(SUM(CASE WHEN u.BO_EXONERADO = TRUE AND HOUR(u.FC_PAGO) BETWEEN 13 AND 18 THEN 1 ELSE 0 END), 0) AS cantTardeEx, COALESCE(SUM(CASE WHEN u.BO_EXONERADO = TRUE AND (HOUR(u.FC_PAGO) >= 19 OR HOUR(u.FC_PAGO) <= 5) THEN 1 ELSE 0 END), 0) AS cantNocheEx FROM SYS_USUARIO u WHERE u.BO_CONGRESISTA = TRUE AND u.FC_PAGO >= ? AND u.FC_PAGO <= ? GROUP BY u.USUARIO_PAGO ORDER BY (montoDiaPagos + montoTardePagos + montoNochePagos) DESC
